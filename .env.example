# URL de base de l'API backend (Laravel), vue du navigateur. Pas de slash final.
# - Via le proxy de dev (même origine, pas de CORS, accessible depuis le
#   réseau local avec `npm run dev:host`) : /api
# - API locale tapée directement (poste seul) : http://127.0.0.1:8000/api
NUXT_PUBLIC_API_BASE=/api

# Cible du proxy de dev quand NUXT_PUBLIC_API_BASE=/api.
# Absente = API distante (le proxy passe Tiger Protect, voir CLAUDE.md §7).
# API_PROXY_TARGET=http://127.0.0.1:8000/api
